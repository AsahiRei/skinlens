# Copy to .env and fill in. EXPO_PUBLIC_* values are compiled into the app
# bundle and are readable by anyone with the APK — never put secret/service
# keys here (Supabase service_role, Cloudinary API secret, etc.).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
EXPO_PUBLIC_GEOAPIFY_API_KEY=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
EXPO_PUBLIC_SENTRY_DSN=
