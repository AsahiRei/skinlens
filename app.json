{
  "expo": {
    "name": "skinlens",
    "slug": "skinlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/skinlens-icon.png",
    "scheme": "skinlens",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asahirei.skinlens"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#327349",
        "foregroundImage": "./assets/images/skinlens-icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.asahirei.skinlens",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-rounded.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#15803d"
        }
      ],
      "@react-native-vector-icons/ionicons",
      "react-native-fast-tflite",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkinLens uses your location to show dermatologists and clinics near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SkinLens needs access to your photos so you can analyze an existing photo of your skin.",
          "cameraPermission": "SkinLens uses the camera to scan your facial skin and verify your face.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#15803d"
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "llama.rn",
        {
          "enableEntitlements": true
        }
      ],
      "./plugins/withOpenCL",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Redaction10-Regular",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Redaction10-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Redaction10-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7205828a-82bf-4692-a58b-2c7569a3284a"
      }
    }
  }
}
